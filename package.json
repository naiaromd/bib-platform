{
  "name": "bib-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:build": "npm_config_legacy_peer_deps=true npx --yes @cloudflare/next-on-pages@1.13.16",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static",
    "pages:preview": "npm run pages:build && wrangler pages dev .vercel/output/static"
  },
  "dependencies": {
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.13.5",
    "@types/node": "22.10.5",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "autoprefixer": "10.4.20",
    "eslint": "9.15.0",
    "eslint-config-next": "15.1.6",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "wrangler": "3.87.0"
  }
}
